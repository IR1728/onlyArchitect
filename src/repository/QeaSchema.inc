// Clean-room minimal SQLite schema for UML 2.5.1 / .qea repository interoperability.
// Defines only the 15 core tables and indexes actively read or written by onlyArchitect.

R"SQL(CREATE TABLE IF NOT EXISTS t_package (
    Package_ID INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    Parent_ID INTEGER DEFAULT 0,
    Name TEXT COLLATE NOCASE,
    Notes TEXT COLLATE NOCASE,
    ea_guid TEXT COLLATE NOCASE,
    Version TEXT DEFAULT '1.0' COLLATE NOCASE,
    UMLVersion TEXT DEFAULT '2.5' COLLATE NOCASE,
    IsControlled INTEGER DEFAULT 0,
    Protected INTEGER DEFAULT 0,
    UseDTD INTEGER DEFAULT 0,
    LogXML INTEGER DEFAULT 0,
    CreatedDate TEXT DEFAULT (datetime('now','localtime')),
    ModifiedDate TEXT DEFAULT (datetime('now','localtime')),
    TPos INTEGER DEFAULT 0,
    PackageFlags TEXT COLLATE NOCASE
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_object (
    Object_ID INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    Object_Type TEXT COLLATE NOCASE,
    Diagram_ID INTEGER DEFAULT 0,
    Name TEXT COLLATE NOCASE,
    Alias TEXT COLLATE NOCASE,
    Author TEXT COLLATE NOCASE,
    Version TEXT DEFAULT '1.0' COLLATE NOCASE,
    Note TEXT COLLATE NOCASE,
    Package_ID INTEGER DEFAULT 0,
    Stereotype TEXT COLLATE NOCASE,
    NType INTEGER DEFAULT 0,
    Complexity TEXT DEFAULT '1' COLLATE NOCASE,
    Status TEXT DEFAULT 'Proposed' COLLATE NOCASE,
    Abstract TEXT DEFAULT '0' COLLATE NOCASE,
    GenType TEXT COLLATE NOCASE,
    GenFile TEXT COLLATE NOCASE,
    Classifier INTEGER DEFAULT 0,
    ParentID INTEGER DEFAULT 0,
    PDATA1 TEXT COLLATE NOCASE,
    PDATA2 TEXT COLLATE NOCASE,
    PDATA3 TEXT COLLATE NOCASE,
    PDATA4 TEXT COLLATE NOCASE,
    PDATA5 TEXT COLLATE NOCASE,
    RunState TEXT COLLATE NOCASE,
    Style TEXT COLLATE NOCASE,
    ea_guid TEXT COLLATE NOCASE,
    IsRoot INTEGER DEFAULT 0,
    IsLeaf INTEGER DEFAULT 0,
    IsSpec INTEGER DEFAULT 0,
    IsActive INTEGER DEFAULT 0,
    CreatedDate TEXT DEFAULT (datetime('now','localtime')),
    ModifiedDate TEXT DEFAULT (datetime('now','localtime')),
    TPos INTEGER DEFAULT 0
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_attribute (
    ID INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    Object_ID INTEGER DEFAULT 0,
    Name TEXT COLLATE NOCASE,
    Scope TEXT COLLATE NOCASE,
    Stereotype TEXT COLLATE NOCASE,
    Type TEXT COLLATE NOCASE,
    [Default] TEXT COLLATE NOCASE,
    Notes TEXT COLLATE NOCASE,
    Pos INTEGER DEFAULT 0,
    ea_guid TEXT COLLATE NOCASE,
    IsStatic INTEGER DEFAULT 0,
    Const INTEGER DEFAULT 0,
    LowerBound TEXT COLLATE NOCASE,
    UpperBound TEXT COLLATE NOCASE,
    IsCollection INTEGER DEFAULT 0,
    IsOrdered INTEGER DEFAULT 0,
    AllowDuplicates INTEGER DEFAULT 0,
    Style TEXT COLLATE NOCASE,
    StyleEx TEXT COLLATE NOCASE
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_attributeconstraints (
    Object_ID INTEGER DEFAULT 0,
    [Constraint] TEXT NOT NULL COLLATE NOCASE,
    AttName TEXT COLLATE NOCASE,
    Type TEXT COLLATE NOCASE,
    Notes TEXT COLLATE NOCASE,
    ID INTEGER NOT NULL,
    PRIMARY KEY ([Constraint], ID)
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_attributetag (
    PropertyID INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    ElementID INTEGER DEFAULT 0,
    Property TEXT COLLATE NOCASE,
    VALUE TEXT COLLATE NOCASE,
    NOTES TEXT COLLATE NOCASE,
    ea_guid TEXT COLLATE NOCASE
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_operation (
    OperationID INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    Object_ID INTEGER DEFAULT 0,
    Name TEXT COLLATE NOCASE,
    Scope TEXT COLLATE NOCASE,
    Type TEXT COLLATE NOCASE,
    Stereotype TEXT COLLATE NOCASE,
    Notes TEXT COLLATE NOCASE,
    Pos INTEGER DEFAULT 0,
    ea_guid TEXT COLLATE NOCASE,
    IsStatic INTEGER DEFAULT 0,
    Abstract TEXT DEFAULT '0' COLLATE NOCASE,
    Const INTEGER DEFAULT 0,
    Pure INTEGER DEFAULT 0,
    IsRoot INTEGER DEFAULT 0,
    IsLeaf INTEGER DEFAULT 0,
    IsQuery INTEGER DEFAULT 0,
    Style TEXT COLLATE NOCASE,
    StyleEx TEXT COLLATE NOCASE
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_operationparams (
    OperationID INTEGER NOT NULL,
    Name TEXT NOT NULL COLLATE NOCASE,
    Type TEXT COLLATE NOCASE,
    [Default] TEXT COLLATE NOCASE,
    Kind TEXT COLLATE NOCASE,
    Notes TEXT COLLATE NOCASE,
    Pos INTEGER DEFAULT 0,
    ea_guid TEXT COLLATE NOCASE
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_operationtag (
    PropertyID INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    ElementID INTEGER DEFAULT 0,
    Property TEXT COLLATE NOCASE,
    VALUE TEXT COLLATE NOCASE,
    NOTES TEXT COLLATE NOCASE,
    ea_guid TEXT COLLATE NOCASE
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_operationpres (
    OperationID INTEGER NOT NULL,
    PreCondition TEXT NOT NULL COLLATE NOCASE,
    Type TEXT COLLATE NOCASE,
    Notes TEXT COLLATE NOCASE
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_operationposts (
    OperationID INTEGER NOT NULL,
    PostCondition TEXT NOT NULL COLLATE NOCASE,
    Type TEXT COLLATE NOCASE,
    Notes TEXT COLLATE NOCASE
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_connector (
    Connector_ID INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    Name TEXT COLLATE NOCASE,
    Direction TEXT COLLATE NOCASE,
    Notes TEXT COLLATE NOCASE,
    Connector_Type TEXT COLLATE NOCASE,
    SubType TEXT COLLATE NOCASE,
    Stereotype TEXT COLLATE NOCASE,
    Start_Object_ID INTEGER DEFAULT 0,
    End_Object_ID INTEGER DEFAULT 0,
    SourceRole TEXT COLLATE NOCASE,
    DestRole TEXT COLLATE NOCASE,
    SourceCard TEXT COLLATE NOCASE,
    DestCard TEXT COLLATE NOCASE,
    SourceIsAggregate INTEGER DEFAULT 0,
    DestIsAggregate INTEGER DEFAULT 0,
    SourceIsNavigable INTEGER DEFAULT 0,
    DestIsNavigable INTEGER DEFAULT 0,
    IsRoot INTEGER DEFAULT 0,
    IsLeaf INTEGER DEFAULT 0,
    IsSpec INTEGER DEFAULT 0,
    IsSignal INTEGER DEFAULT 0,
    IsStimulus INTEGER DEFAULT 0,
    SeqNo INTEGER DEFAULT 0,
    PtStartX INTEGER DEFAULT 0,
    PtStartY INTEGER DEFAULT 0,
    PtEndX INTEGER DEFAULT 0,
    PtEndY INTEGER DEFAULT 0,
    DiagramID INTEGER DEFAULT 0,
    PDATA1 TEXT COLLATE NOCASE,
    PDATA2 TEXT COLLATE NOCASE,
    PDATA3 TEXT COLLATE NOCASE,
    PDATA4 TEXT COLLATE NOCASE,
    PDATA5 TEXT COLLATE NOCASE,
    StyleEx TEXT COLLATE NOCASE,
    ea_guid TEXT COLLATE NOCASE
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_diagram (
    Diagram_ID INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    Package_ID INTEGER DEFAULT 0,
    ParentID INTEGER DEFAULT 0,
    Diagram_Type TEXT COLLATE NOCASE,
    Name TEXT COLLATE NOCASE,
    Version TEXT DEFAULT '1.0' COLLATE NOCASE,
    Author TEXT COLLATE NOCASE,
    Notes TEXT COLLATE NOCASE,
    Stereotype TEXT COLLATE NOCASE,
    cx INTEGER DEFAULT 1000,
    cy INTEGER DEFAULT 800,
    Scale INTEGER DEFAULT 100,
    StyleEx TEXT COLLATE NOCASE,
    ea_guid TEXT COLLATE NOCASE,
    AttPub INTEGER DEFAULT 1,
    AttPri INTEGER DEFAULT 1,
    AttPro INTEGER DEFAULT 1,
    ShowForeign INTEGER DEFAULT 1,
    ShowBorder INTEGER DEFAULT 1,
    ShowPackageContents INTEGER DEFAULT 1,
    Locked INTEGER DEFAULT 0,
    CreatedDate TEXT DEFAULT (datetime('now','localtime')),
    ModifiedDate TEXT DEFAULT (datetime('now','localtime'))
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_diagramobjects (
    Diagram_ID INTEGER DEFAULT 0,
    Object_ID INTEGER DEFAULT 0,
    RectTop INTEGER DEFAULT 0,
    RectLeft INTEGER DEFAULT 0,
    RectRight INTEGER DEFAULT 0,
    RectBottom INTEGER DEFAULT 0,
    Sequence INTEGER DEFAULT 0,
    ObjectStyle TEXT COLLATE NOCASE,
    Instance_ID INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS t_diagramlinks (
    DiagramID INTEGER DEFAULT 0,
    ConnectorID INTEGER DEFAULT 0,
    Geometry TEXT COLLATE NOCASE,
    Style TEXT COLLATE NOCASE,
    Hidden INTEGER DEFAULT 0,
    Path TEXT COLLATE NOCASE,
    Instance_ID INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT
))SQL",

R"SQL(CREATE TABLE IF NOT EXISTS usys_system (
    Property TEXT NOT NULL PRIMARY KEY COLLATE NOCASE,
    Value TEXT COLLATE NOCASE
))SQL",

R"SQL(CREATE INDEX IF NOT EXISTS idx_package_parent ON t_package(Parent_ID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_package_guid ON t_package(ea_guid))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_object_package ON t_object(Package_ID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_object_parent ON t_object(ParentID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_object_guid ON t_object(ea_guid))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_attribute_object ON t_attribute(Object_ID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_attribute_guid ON t_attribute(ea_guid))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_operation_object ON t_operation(Object_ID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_operation_guid ON t_operation(ea_guid))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_opparams_op ON t_operationparams(OperationID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_connector_start ON t_connector(Start_Object_ID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_connector_end ON t_connector(End_Object_ID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_connector_guid ON t_connector(ea_guid))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_diagram_package ON t_diagram(Package_ID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_diagram_guid ON t_diagram(ea_guid))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_diagobj_diagram ON t_diagramobjects(Diagram_ID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_diagobj_object ON t_diagramobjects(Object_ID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_diaglink_diagram ON t_diagramlinks(DiagramID))SQL",
R"SQL(CREATE INDEX IF NOT EXISTS idx_diaglink_connector ON t_diagramlinks(ConnectorID))SQL"
